# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/tmp/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# operator roster and scores — never the public demo
/data/private/

# credentials, keys, and browser auth dumps
credentials.json
*credentials*.json
*.auth.json
/playwright/.auth/
.auth/

# cloud workspace leftovers
/uploads
/agent-tools

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
