# Copy to .env.local. Leave these empty until you generate your own values.
# Example only — do not reuse a password from chat, screenshots, or deploy logs.
#   SITE_PASSWORD=changeme
# Generate a long random string for ingest, for example:
#   openssl rand -hex 32
SITE_PASSWORD=
INGEST_SECRET=

# Optional. Base64 JSON that replaces data/demo/roster.json and data/demo/seed.json
# on the server only. Keep the files in data/private/ (gitignored) and set these
# in the host environment. Do not commit the encoded values.
#   base64 -w 0 data/private/roster.json
#   base64 -w 0 data/private/seed.json
VILLAGE_ROSTER_B64=
VILLAGE_SEED_B64=

# Scores stay in process memory. Cold start uses the demo seed, or the env
# overrides above. Redis, Blob, and KV are not required.

# Set to 1 only on a preview you intend to drive with Playwright hooks.
# Production builds omit window.__VILLAGE_TEST__ unless this is set.
NEXT_PUBLIC_VILLAGE_TEST=
